<Window x:Class="AndroidPCController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AndroidPCController.App.ViewModels"
        Title="Android PC Controller"
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Closing="MainWindow_Closing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource SurfaceDarkBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource SurfaceLightBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="&#xE737;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource PrimaryAccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Android PC Controller"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource WindowButtonStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeBtn"
                            Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource WindowButtonStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize"
                            Margin="2,0" />
                    <Button Content="&#xE106;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource CloseButtonStyle}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Click="CloseButton_Click"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceMediumBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,16,16,8">
                            <StackPanel>
                                <Ellipse Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource PrimaryAccent}" Offset="0" />
                                            <GradientStop Color="{StaticResource PrimaryAccentDark}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="Android PC Controller"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="v1.0.0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Separator Grid.Row="0" Margin="12,64" Background="{StaticResource SurfaceLightBrush}" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,4">
                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             IsChecked="True"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Dashboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Devices">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Devices" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Controller">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Controller" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Files">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Files" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Apps">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Apps" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="ScreenRecorder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Screen Recorder" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Screenshots">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Screenshots" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Terminal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Terminal" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Logs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=";&#xE7BA;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Logs" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <Separator Background="{StaticResource SurfaceLightBrush}" Margin="0,8" />

                                <RadioButton Style="{StaticResource SidebarButtonStyle}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="24" VerticalAlignment="Center" />
                                        <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Padding="12" Background="{StaticResource SurfaceDarkBrush}" CornerRadius="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ConnectionStatusText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <Ellipse x:Name="StatusIndicator"
                                         Width="8" Height="8"
                                         Fill="{StaticResource DangerRedBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="0,4,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerRedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource SurfaceDarkBrush}">
                    <Grid>
                        <Frame x:Name="ContentFrame"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent" />
                        <TextBlock x:Name="PlaceholderText"
                                   Text="{Binding CurrentPageTitle}"
                                   FontSize="28"
                                   FontWeight="Light"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SurfaceMediumBrush}" CornerRadius="0,0,8,8">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerRedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusBarText, FallbackValue='Ready'}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="Android PC Controller v1.0.0"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

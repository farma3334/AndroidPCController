<Window x:Class="AndroidPCController.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AndroidPCController.App.ViewModels"
        Title="Android PC Controller"
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Closing="MainWindow_Closing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Animated sidebar nav button - modern icon-only design -->
        <Style x:Key="AnimatedSidebarButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B6B80" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Navigation" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- Background with rounded corners -->
                            <Border x:Name="bgBorder"
                                    Background="Transparent"
                                    CornerRadius="10"
                                    Margin="{TemplateBinding Margin}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Active indicator - glowing bar on left -->
                            <Border x:Name="ActiveIndicator"
                                    Width="4"
                                    Height="0"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Margin}"
                                    Background="#8B5CF6"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>

                            <!-- Glow effect for active state -->
                            <Border x:Name="GlowBorder"
                                    CornerRadius="10"
                                    Margin="{TemplateBinding Margin}"
                                    Background="Transparent"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="#E2E2F0" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator"
                                                             Storyboard.TargetProperty="Height"
                                                             To="28" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <PowerEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveIndicator"
                                                             Storyboard.TargetProperty="Height"
                                                             To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <PowerEase EasingMode="EaseIn"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bgBorder" Property="Background" Value="#208B5CF6" />
                                <Setter Property="Foreground" Value="#D8B4FE" />
                                <Setter TargetName="ActiveIndicator" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                            <GradientStop Color="#D946EF" Offset="0.5"/>
                                            <GradientStop Color="#FB7185" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                                <Setter TargetName="ActiveIndicator" Property="Height" Value="28" />
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="1" />
                                <Setter TargetName="GlowBorder" Property="Background" Value="#0A8B5CF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0B0B16"
            CornerRadius="12"
            BorderBrush="#1A1A2E"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/logo_title.png"
                           Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                    <TextBlock Text="Android PC Controller"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F7"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource WindowButtonStyle}"
                            Foreground="#9D9DB2"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeBtn"
                            Content="&#xE922;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource WindowButtonStyle}"
                            Foreground="#9D9DB2"
                            Click="MaximizeButton_Click"
                            ToolTip="Maximize"
                            Margin="2,0" />
                    <Button Content="&#xE106;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource CloseButtonStyle}"
                            Foreground="#9D9DB2"
                            Click="CloseButton_Click"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Animated Sidebar -->
                <Border x:Name="SidebarBorder" Grid.Column="0"
                        Background="#0A0A14"
                        BorderBrush="#1A1A2E"
                        BorderThickness="0,0,1,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.3" Direction="90"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Logo Area -->
                        <Border Grid.Row="0" Padding="0,18,0,14" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="44" Height="44" HorizontalAlignment="Center">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                            <GradientStop Color="#D946EF" Offset="0.5"/>
                                            <GradientStop Color="#FB7185" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Image Source="Assets/logo_small.png"
                                       Width="26" Height="26"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Separator Grid.Row="0" Margin="12,70,12,0" Background="#1A1A2E" />

                        <!-- Navigation Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel x:Name="NavItems" Margin="0,0">
                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             IsChecked="True"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Dashboard"
                                             ToolTip="Dashboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Devices"
                                             ToolTip="Devices">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Controller"
                                             ToolTip="Controller">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="PhoneDesktop"
                                             ToolTip="Phone Desktop">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Notifications"
                                             ToolTip="Notifications">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Automation"
                                             ToolTip="Automation">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Files"
                                             ToolTip="Files">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Apps"
                                             ToolTip="Apps">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="ScreenRecorder"
                                             ToolTip="Screen Recorder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Screenshots"
                                             ToolTip="Screenshots">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Terminal"
                                             ToolTip="Terminal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Logs"
                                             ToolTip="Logs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Developer"
                                             ToolTip="Developer">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <Separator Background="#1A1A2E" Margin="8,6" />

                                <RadioButton Style="{StaticResource AnimatedSidebarButton}"
                                             Command="{Binding NavigateCommand}"
                                             CommandParameter="Settings"
                                             ToolTip="Settings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="24" FontSize="16" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

<!-- Connection Status -->
                         <Border Grid.Row="2" Padding="12,10" Background="#0A0A14" CornerRadius="0,0,12,0" BorderBrush="#1A1A2E" BorderThickness="0,1,0,0">
                             <StackPanel HorizontalAlignment="Center">
                                 <Grid Width="36" Height="36" HorizontalAlignment="Center">
                                     <Ellipse x:Name="StatusRing"
                                              Width="36" Height="36"
                                              Stroke="#333344" StrokeThickness="2">
                                         <Ellipse.Style>
                                             <Style TargetType="Ellipse">
                                                 <Setter Property="Fill" Value="Transparent" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                         <Setter Property="Fill" Value="#1534D399" />
                                                         <Setter Property="Stroke" Value="#34D399" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Ellipse.Style>
                                     </Ellipse>
                                     <Ellipse x:Name="StatusDot"
                                              Width="10" Height="10"
                                              Fill="#EF4444"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                         <Ellipse.Style>
                                             <Style TargetType="Ellipse">
                                                 <Setter Property="Fill" Value="#EF4444" />
                                                 <Setter Property="Effect">
                                                     <Setter.Value>
                                                         <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                     </Setter.Value>
                                                 </Setter>
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                                         <Setter Property="Fill" Value="#34D399" />
                                                         <Setter Property="Effect">
                                                             <Setter.Value>
                                                                 <DropShadowEffect Color="#34D399" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                                                             </Setter.Value>
                                                         </Setter>
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Ellipse.Style>
                                     </Ellipse>
                                 </Grid>
                             </StackPanel>
                         </Border>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Border Grid.Column="1" Background="#07070D">
                    <Grid>
                        <Frame x:Name="ContentFrame"
                               NavigationUIVisibility="Hidden"
                               Background="Transparent" />
                        <TextBlock x:Name="PlaceholderText"
                                   Text="{Binding CurrentPageTitle}"
                                   FontSize="28"
                                   FontWeight="Light"
                                   Foreground="#9D9DB2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#0E0E1A" CornerRadius="0,0,12,12"
                    BorderBrush="#1A1A2E" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#EF4444" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                            <Setter Property="Fill" Value="#34D399" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusBarText, FallbackValue='Ready'}"
                                   FontSize="11"
                                   Foreground="#9D9DB2"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="Android PC Controller v1.0.0"
                               FontSize="11"
                               Foreground="#6B6B80"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Content="&#xE74A;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource WindowButtonStyle}"
                            Foreground="#9D9DB2"
                            Click="MiniWindowButton_Click"
                            ToolTip="Mini Phone Window"
                            Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window x:Class="AndroidPCController.App.MiniPhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AndroidPCController.App.ViewModels"
        Title="Mini Phone"
        Width="300" Height="500"
        MinWidth="300" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding IsTopmost}"
        WindowStartupLocation="Manual"
        Left="50" Top="100">

    <Window.DataContext>
        <vm:MiniPhoneViewModel />
    </Window.DataContext>

    <Border Background="#CC1A1A2E"
            BorderBrush="#0F3460"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding DeviceName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#E0E0E0" VerticalAlignment="Center" MaxWidth="160"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE921;"
                            FontFamily="Segoe MDL2 Assets"
                            Width="28" Height="24"
                            Background="Transparent" Foreground="#9E9E9E"
                            BorderThickness="0" Cursor="Hand"
                            FontSize="10"
                            ToolTip="Minimize"
                            Click="MinimizeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="&#xE106;"
                            FontFamily="Segoe MDL2 Assets"
                            Width="28" Height="24"
                            Background="Transparent" Foreground="#9E9E9E"
                            BorderThickness="0" Cursor="Hand"
                            FontSize="10"
                            ToolTip="Close"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0A1A2E" CornerRadius="4" Margin="8,0">
                <Grid>
                    <TextBlock Text="Screen preview&#x0a;coming soon..."
                               FontSize="13" Foreground="#4A4A6A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#CC16213E" CornerRadius="0,0,12,12">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center">
                            <Run Text="{Binding BatteryLevel, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2" FontSize="10" Foreground="#9E9E9E"
                               VerticalAlignment="Center">
                        <Run Text="{Binding BatteryState, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Application x:Class="AndroidPCController.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App"
             xmlns:conv="clr-namespace:AndroidPCController.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="Cyan"
                                 SecondaryColor="LightBlue" />

                <ResourceDictionary>
                    <conv:StringToColorConverter x:Key="StringToColorConverter" />

                    <Color x:Key="PrimaryAccent">#00D2FF</Color>
                    <Color x:Key="PrimaryAccentDark">#0099CC</Color>
                    <Color x:Key="PrimaryAccentLight">#33DDFF</Color>
                    <Color x:Key="SurfaceDark">#1A1A2E</Color>
                    <Color x:Key="SurfaceMedium">#16213E</Color>
                    <Color x:Key="SurfaceLight">#1E2D4A</Color>
                    <Color x:Key="SurfaceCard">#0F3460</Color>
                    <Color x:Key="TextPrimary">#E0E0E0</Color>
                    <Color x:Key="TextSecondary">#9E9E9E</Color>
                    <Color x:Key="DangerRed">#EF4444</Color>
                    <Color x:Key="SuccessGreen">#22C55E</Color>
                    <Color x:Key="WarningAmber">#F59E0B</Color>

                    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}" />
                    <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="{StaticResource PrimaryAccentDark}" />
                    <SolidColorBrush x:Key="PrimaryAccentLightBrush" Color="{StaticResource PrimaryAccentLight}" />
                    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
                    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMedium}" />
                    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
                    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
                    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
                    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />
                    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}" />

                    <Style x:Key="CardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black" />
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="Margin" Value="4,1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="GroupName" Value="Navigation" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="{TemplateBinding Margin}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceLightBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1A00D2FF" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="WindowButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="CloseButtonStyle" TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Application x:Class="AndroidPCController.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App"
             xmlns:conv="clr-namespace:AndroidPCController.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="DeepPurple"
                                 SecondaryColor="Pink" />

                <ResourceDictionary>
                    <conv:StringToColorConverter x:Key="StringToColorConverter" />

                    <!-- Website color tokens -->
                    <Color x:Key="PrimaryAccent">#8B5CF6</Color>
                    <Color x:Key="PrimaryAccentDark">#7C3AED</Color>
                    <Color x:Key="PrimaryAccentLight">#A78BFA</Color>
                    <Color x:Key="FuchsiaAccent">#D946EF</Color>
                    <Color x:Key="RoseAccent">#FB7185</Color>
                    <Color x:Key="CyanAccent">#22D3EE</Color>
                    <Color x:Key="GreenAccent">#34D399</Color>

                    <Color x:Key="SurfaceDark">#07070D</Color>
                    <Color x:Key="SurfaceMedium">#0B0B16</Color>
                    <Color x:Key="SurfaceLight">#13131F</Color>
                    <Color x:Key="SurfaceCard">#16162A</Color>
                    <Color x:Key="SurfaceCardHover">#1C1C35</Color>

                    <Color x:Key="TextPrimary">#F2F2F7</Color>
                    <Color x:Key="TextSecondary">#9D9DB2</Color>
                    <Color x:Key="TextMuted">#6B6B80</Color>

                    <Color x:Key="BorderSubtle">#1A1A2E</Color>
                    <Color x:Key="BorderMedium">#252540</Color>

                    <Color x:Key="DangerRed">#EF4444</Color>
                    <Color x:Key="SuccessGreen">#34D399</Color>
                    <Color x:Key="WarningAmber">#FBBF24</Color>

                    <!-- Gradient brushes -->
                    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#8B5CF6" Offset="0" />
                        <GradientStop Color="#D946EF" Offset="0.55" />
                        <GradientStop Color="#FB7185" Offset="1" />
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="AccentGradientVertical" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8B5CF6" Offset="0" />
                        <GradientStop Color="#D946EF" Offset="0.55" />
                        <GradientStop Color="#FB7185" Offset="1" />
                    </LinearGradientBrush>

                    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#338B5CF6" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>

                    <!-- Solid brushes -->
                    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccent}" />
                    <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="{StaticResource PrimaryAccentDark}" />
                    <SolidColorBrush x:Key="PrimaryAccentLightBrush" Color="{StaticResource PrimaryAccentLight}" />
                    <SolidColorBrush x:Key="FuchsiaAccentBrush" Color="{StaticResource FuchsiaAccent}" />
                    <SolidColorBrush x:Key="RoseAccentBrush" Color="{StaticResource RoseAccent}" />
                    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccent}" />
                    <SolidColorBrush x:Key="GreenAccentBrush" Color="{StaticResource GreenAccent}" />

                    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
                    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="{StaticResource SurfaceMedium}" />
                    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLight}" />
                    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
                    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHover}" />

                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

                    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
                    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}" />

                    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />
                    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />
                    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}" />

                    <!-- Card style with glassmorphism -->
                    <Style x:Key="CardStyle" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="16" />
                        <Setter Property="Padding" Value="20" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" Color="#8B5CF6" />
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Sidebar button style with animations -->
                    <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Padding" Value="14,10" />
                        <Setter Property="Margin" Value="6,2" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="GroupName" Value="Navigation" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="12"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="{TemplateBinding Margin}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#15FFFFFF" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#188B5CF6" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentLightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Window button styles -->
                    <Style x:Key="WindowButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#20FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="CloseButtonStyle" TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource DangerRedBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Tool button style for controller toolbar -->
                    <Style x:Key="ToolButton" TargetType="Button">
                        <Setter Property="Background" Value="#15FFFFFF" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#258B5CF6" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentLightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Settings panel style -->
                    <Style x:Key="SettingsPanel" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="16" />
                    </Style>

                    <!-- Slider style -->
                    <Style x:Key="SliderStyle" TargetType="Slider">
                        <Setter Property="Minimum" Value="0"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                        <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
                        <Setter Property="Height" Value="24"/>
                    </Style>

                    <!-- Combo style -->
                    <Style x:Key="ComboStyle" TargetType="ComboBox">
                        <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="10,6"/>
                    </Style>

                    <!-- Status text style -->
                    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Margin" Value="0,0,12,0"/>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

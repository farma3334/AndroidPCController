<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AndroidPCController.Core\AndroidPCController.Core.csproj" />
    <ProjectReference Include="..\AndroidPCController.Infrastructure\AndroidPCController.Infrastructure.csproj" />
    <ProjectReference Include="..\AndroidPCController.Adb\AndroidPCController.Adb.csproj" />

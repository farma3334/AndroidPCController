<UserControl x:Class="AndroidPCController.App.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App.Pages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1a1a2e">

    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="#1a1a2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0f3460"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Devices" FontSize="18" FontWeight="Bold"
                           Foreground="#e0e0e0" Margin="4,4,4,12"/>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Background="#0f3460" Foreground="#e0e0e0" BorderBrush="#1a1a4e"
                             BorderThickness="1" Padding="8,6" FontSize="13"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Tag" Value="Search devices..."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource ControlButton}"
                            Margin="8,0,0,0" Padding="8,6"
                            Command="{Binding RefreshDevicesCommand}">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="itemBorder" Style="{StaticResource ListItemStyle}"
                                        MouseLeftButtonDown="DeviceItem_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#ff5252"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                            <Setter Property="Fill" Value="#00e676"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Unauthorized">
                                                            <Setter Property="Fill" Value="#ffc107"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Model}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#e0e0e0"/>
                                            <TextBlock FontSize="11" Foreground="#a0a0a0">
                                                <Run Text="{Binding Serial, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" FontSize="11" Foreground="#a0a0a0"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding AndroidVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      Background="#1a1a4e" Cursor="SizeWE"/>

        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Device Details" FontSize="18" FontWeight="Bold"
                           Foreground="#e0e0e0" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedDevice}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedDevice, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="64" Height="64" CornerRadius="32" Background="#0f3460"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Cellphone" Width="36" Height="36"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                                     Foreground="#00d2ff"/>
                        </Border>

                        <TextBlock Text="{Binding Model}" FontSize="18" FontWeight="Bold"
                                   Foreground="#e0e0e0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Manufacturer}" FontSize="13" Foreground="#a0a0a0"
                                   HorizontalAlignment="Center" Margin="0,2,0,16"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Serial" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Serial}" FontSize="12" Foreground="#e0e0e0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Android" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#e0e0e0">
                                <Run Text="{Binding AndroidVersion, Mode=OneWay}"/>
                                <Run Text=" (API "/>
                                <Run Text="{Binding ApiLevel, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Connection" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" FontSize="12" Foreground="#e0e0e0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Screen" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#e0e0e0">
                                <Run Text="{Binding ScreenWidth, Mode=OneWay}"/>
                                <Run Text="x"/>
                                <Run Text="{Binding ScreenHeight, Mode=OneWay}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding ScreenDensity, Mode=OneWay}"/>
                                <Run Text=" dpi)"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Battery" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#e0e0e0">
                                <Run Text="{Binding BatteryLevel, Mode=OneWay}"/>
                                <Run Text="% "/>
                                <Run Text="{Binding BatteryState, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IP Address" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontSize="12" Foreground="#e0e0e0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chipset" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Chipset}" FontSize="12" Foreground="#e0e0e0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total RAM" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalRam}" FontSize="12" Foreground="#e0e0e0"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Last Seen" FontSize="12" Foreground="#a0a0a0"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastSeen, StringFormat='{}{0:g}'}"
                                       FontSize="12" Foreground="#e0e0e0"/>
                        </Grid>

                        <Separator Background="#1a1a4e" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource ControlButton}" Padding="16,8"
                                    Command="{Binding DataContext.ConnectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Serial}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Link" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Connect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ControlButton}" Padding="16,8"
                                    Command="{Binding DataContext.DisconnectDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Serial}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LinkOff" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="Devices" Width="48" Height="48"
                                             Foreground="#1a1a4e" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a device to view details" FontSize="13"
                               Foreground="#a0a0a0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

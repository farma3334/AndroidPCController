<UserControl x:Class="AndroidPCController.App.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App.Pages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1a1a2e"
             AllowDrop="True" Drop="FilesPage_Drop" DragOver="FilesPage_DragOver"
             DragLeave="FilesPage_DragLeave">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="#1a1a2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BreadcrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00d2ff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Files" FontSize="18" FontWeight="Bold"
                               Foreground="#e0e0e0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="20" Background="#1a1a4e" Margin="12,0"/>
                    <TextBlock x:Name="DeviceLabel" Text="No device selected" FontSize="13"
                               Foreground="#a0a0a0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionBtn}"
                            Command="{Binding UploadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Upload" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}"
                            Command="{Binding DownloadCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Download" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}"
                            Command="{Binding DeleteSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Delete" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBtn}"
                            Command="{Binding CreateFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderPlus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="New Folder" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand"
                                MouseLeftButtonDown="StorageToggle_Click">
                        <materialDesign:PackIcon x:Name="StorageChevron" Kind="ChevronDown" Width="16" Height="16"
                                                 Foreground="#a0a0a0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Storage Analyzer" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#e0e0e0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionBtn}"
                                Command="{Binding RefreshStorageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Refresh Storage" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" x:Name="StorageContent" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="StorageInfoText"
                                       Text="{Binding StorageInfoText}" FontSize="12"
                                       Foreground="#a0a0a0" Margin="0,0,0,4"/>
                            <ProgressBar Grid.Row="1" x:Name="StorageBar" Value="{Binding StoragePercentage}" Maximum="100"
                                         Height="8" Background="#1a1a4e" Foreground="#00d2ff"
                                         BorderBrush="#1a1a4e" BorderThickness="0"/>
                        </Grid>

                        <TextBlock Grid.Column="1" x:Name="StorageLoadingText" Text="Loading..."
                                   FontSize="12" Foreground="#a0a0a0" VerticalAlignment="Center"
                                   Visibility="{Binding IsStorageLoading, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding StorageCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#e0e0e0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <Border Height="6" Background="#1a1a4e" CornerRadius="3"/>
                                        <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                                Background="{Binding Color}"
                                                Width="{Binding Percentage, Converter={x:Static local:FilesPage.PercentageToWidthConverter}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="2" FontSize="11" Foreground="#a0a0a0"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding SizeBytes, Converter={x:Static local:FilesPage.BytesToStringConverter}}"/>

                                    <TextBlock Grid.Column="3" FontSize="11" Foreground="#a0a0a0"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding Percentage, StringFormat='{}{0:F1}%'}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="8,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl x:Name="Breadcrumbs" ItemsSource="{Binding BreadcrumbSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BreadcrumbButton}"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"/>
                                    <TextBlock Text="/" Foreground="#a0a0a0" Margin="4,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBox Grid.Column="1" Width="220" Background="#0f3460" Foreground="#e0e0e0"
                         BorderBrush="#1a1a4e" BorderThickness="1" Padding="8,4" FontSize="12"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search files..."/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource PanelStyle}" Padding="0" ClipToBounds="True">
                <ListView x:Name="FileListView" ItemsSource="{Binding Files}"
                          Background="Transparent" Foreground="#e0e0e0"
                          BorderThickness="0" FontSize="13"
                          SelectionMode="Extended"
                           SelectionChanged="FileListView_SelectionChanged"
                           MouseDoubleClick="FileListView_MouseDoubleClick">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#e0e0e0"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0f3460"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0f3460"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView x:Name="FileListViewStyle">
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#0f3460"/>
                                    <Setter Property="Foreground" Value="#a0a0a0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#1a1a4e"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="Name" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Foreground="#00d2ff"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modified" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileType}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border x:Name="DragOverlay" Background="#1a1a2e" Opacity="0.85"
                    CornerRadius="8" Visibility="Collapsed"
                    BorderBrush="#00d2ff" BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Upload" Width="64" Height="64"
                                             Foreground="#00d2ff" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop files here to upload" FontSize="18" FontWeight="SemiBold"
                               Foreground="#e0e0e0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <materialDesign:PackIcon Kind="FolderOpen" Width="64" Height="64"
                                         Foreground="#1a1a4e" HorizontalAlignment="Center"/>
                <TextBlock Text="This folder is empty" FontSize="16" Foreground="#a0a0a0"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Drop files here or click Upload" FontSize="12"
                           Foreground="#a0a0a0" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Padding="10,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="TransferInfoText" Text="Ready"
                           FontSize="12" Foreground="#a0a0a0" VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="1" x:Name="TransferProgress" Value="0" Maximum="100"
                             Height="4" Margin="12,0" VerticalAlignment="Center"
                             Background="#1a1a4e" Foreground="#00d2ff" Visibility="Collapsed"/>

                <TextBlock Grid.Column="2" x:Name="TransferSpeedText" Text=""
                           FontSize="12" Foreground="#a0a0a0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

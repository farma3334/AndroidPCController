<UserControl x:Class="AndroidPCController.App.Pages.ScreenRecorderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App.Pages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1a1a2e">

    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ControlBtn" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="#1a1a2e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordBtn" TargetType="Button">
            <Setter Property="Background" Value="#ff5252"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="FormFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#a0a0a0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="24" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RecordingDot" Width="14" Height="14" Fill="#ff5252"
                                 Margin="0,0,10,0" Visibility="Collapsed">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.3" Duration="0:0:1"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="RecordingStatusLabel" Text="Screen Recorder"
                                   FontSize="22" FontWeight="Bold" Foreground="#e0e0e0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#0a0a1a" CornerRadius="12" Padding="32,24"
                        Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="DurationDisplay" Text="00:00:00"
                                   FontSize="48" FontWeight="Bold" Foreground="#e0e0e0"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cascadia Code,Consolas,Courier New"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock FontSize="14" Foreground="#a0a0a0" Margin="0,0,16,0">
                                <Run Text="FPS: "/>
                                <Run x:Name="FpsDisplay" Text="--" Foreground="#00d2ff"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Foreground="#a0a0a0">
                                <Run Text="Bitrate: "/>
                                <Run x:Name="BitrateDisplay" Text="--" Foreground="#00d2ff"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                    <Button x:Name="StartButton" Style="{StaticResource RecordBtn}"
                            Command="{Binding StartRecordingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Record" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Start" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource ControlBtn}"
                            Command="{Binding StopRecordingCommand}"
                            IsEnabled="{Binding IsRecording}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource ControlBtn}"
                            Command="{Binding PauseResumeCommand}"
                            IsEnabled="{Binding IsRecording}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="PauseIcon" Kind="Pause" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Resolution" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox Style="{StaticResource ComboStyle}" Width="140"
                                  ItemsSource="{Binding AvailableResolutions}"
                                  SelectedItem="{Binding RecordResolution}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="FPS" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox Style="{StaticResource ComboStyle}" Width="80"
                                  ItemsSource="{Binding AvailableFpsValues}"
                                  SelectedItem="{Binding RecordFps}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bitrate (Mbps)" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox Style="{StaticResource ComboStyle}" Width="80"
                                  ItemsSource="{Binding AvailableBitrateValues}"
                                  SelectedItem="{Binding RecordingBitrate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Codec" Style="{StaticResource FormFieldLabel}"/>
                        <ComboBox Style="{StaticResource ComboStyle}" Width="100"
                                  ItemsSource="{Binding AvailableCodecs}"
                                  SelectedItem="{Binding RecordCodec}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <CheckBox Content="Audio" Foreground="#e0e0e0"
                                  IsChecked="{Binding RecordAudio}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Recent Recordings" FontSize="16" FontWeight="Bold"
                           Foreground="#e0e0e0" Margin="0,0,0,12"/>

                <ListView x:Name="RecordingsListView" Grid.Row="1"
                          ItemsSource="{Binding RecentRecordings}"
                          Background="Transparent" Foreground="#e0e0e0"
                          BorderThickness="0" FontSize="13">
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#e0e0e0"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0f3460"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#0f3460"/>
                                    <Setter Property="Foreground" Value="#a0a0a0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#1a1a4e"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Header="File" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Video" Width="16" Height="16"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Foreground="#00d2ff"/>
                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Duration" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationDisplay}" VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code,Consolas,Courier New"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Date" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="4" Tag="{Binding FilePath}"
                                                    Click="PlayRecording_Click"
                                                    ToolTip="Play">
                                                <materialDesign:PackIcon Kind="Play" Width="16" Height="16"
                                                                         Foreground="#00d2ff"/>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="4" Tag="{Binding FilePath}"
                                                    Click="OpenFolder_Click"
                                                    ToolTip="Open folder">
                                                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16"
                                                                         Foreground="#a0a0a0"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="RecordingsEmpty" Grid.Row="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentRecordings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="VideoOff" Width="64" Height="64"
                                             Foreground="#1a1a4e" HorizontalAlignment="Center"/>
                    <TextBlock Text="No recordings yet" FontSize="16" Foreground="#a0a0a0"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Click Start to begin recording" FontSize="12"
                               Foreground="#a0a0a0" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AndroidPCController.App.Pages.ScreenshotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App.Pages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1a1a2e">

    <UserControl.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="#1a1a2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureBtn" TargetType="Button">
            <Setter Property="Background" Value="#00d2ff"/>
            <Setter Property="Foreground" Value="#1a1a2e"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <TextBlock Text="Screenshots" FontSize="18" FontWeight="Bold"
                               Foreground="#e0e0e0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CaptureButton" Style="{StaticResource CaptureBtn}"
                                Command="{Binding CaptureScreenshotCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Camera" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Capture" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}" Margin="8,0,0,0"
                                Command="{Binding SelectAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SelectAll" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Select All" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}"
                                Command="{Binding DeleteSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Delete" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}"
                                Command="{Binding OpenSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="OpenInApp" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Open" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}"
                                Command="{Binding CopyToClipboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Copy" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="8" ClipToBounds="True">
                <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Screenshots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="thumbBorder" Width="180" Height="160" Margin="6"
                                        CornerRadius="6" BorderBrush="#1a1a4e" BorderThickness="2"
                                        ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonDown="Thumbnail_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0f3460"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00d2ff"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Margin="4">
                                            <CheckBox x:Name="SelectCheck" IsHitTestVisible="False"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top"/>
                                        </StackPanel>
                                        <Border Background="#000000" Opacity="0.6" CornerRadius="0,0,6,6"
                                                VerticalAlignment="Bottom" Padding="6,3">
                                            <TextBlock Text="{Binding CaptureTime, StringFormat='{}{0:HH:mm:ss}'}"
                                                       FontSize="10" Foreground="#e0e0e0"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="ScreenshotsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Screenshots.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="CameraOff" Width="64" Height="64"
                                             Foreground="#1a1a4e" HorizontalAlignment="Center"/>
                    <TextBlock Text="No screenshots yet" FontSize="16" Foreground="#a0a0a0"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Connect a device and click Capture" FontSize="12"
                               Foreground="#a0a0a0" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      Background="#1a1a4e" Cursor="SizeWE"/>

        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Preview" FontSize="16" FontWeight="Bold"
                           Foreground="#e0e0e0" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Background="#0a0a1a" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedScreenshot}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Kind="ImageOff" Width="48" Height="48"
                                                     Foreground="#1a1a4e" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a screenshot" FontSize="13"
                                       Foreground="#a0a0a0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="PreviewInfo" Grid.Row="1" VerticalAlignment="Bottom"
                            Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedScreenshot}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="PreviewFileName" FontSize="12" Foreground="#a0a0a0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewDimensions" FontSize="11" Foreground="#a0a0a0" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AndroidPCController.App.Pages.PhoneDesktopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="TopBarStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderBrush" Value="#0f3460"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="#1a1a2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a1a4e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0f3460"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#16213e" Offset="0.5"/>
                <GradientStop Color="#1a1a2e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Style="{StaticResource TopBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#0f3460" Margin="0,0,12,0">
                        <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="#00d2ff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#e0e0e0"/>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                                   Foreground="#9E9E9E"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#00d2ff" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock VerticalAlignment="Center" Foreground="#e0e0e0" FontSize="13">
                            <Run Text="{Binding BatteryLevel, Mode=OneWay}"/>
                            <Run Text="%"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentTime}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#e0e0e0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- App Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="MaxWidth" Value="800"/>
                    </Style>
                </Grid.Style>
                <ItemsControl ItemsSource="{Binding InstalledApps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AppTileButton}"
                                    Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding PackageName}">
                                <Border Background="#16213e" CornerRadius="16" Padding="8"
                                        Margin="6" Width="88" Height="96">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.2" ShadowDepth="2" Color="#000000"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#16213e"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Background" Value="#1a1a4e"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Width="44" Height="44" CornerRadius="22"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{Binding IconColor, Converter={StaticResource StringToColorConverter}}">
                                            <TextBlock Text="{Binding IconChar}" FontSize="20" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding AppName}" FontSize="10"
                                                   Foreground="#e0e0e0" HorizontalAlignment="Center"
                                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="76"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Date/Time Center Bar -->
        <Border Grid.Row="2" Background="#16213e" Padding="16,8" BorderBrush="#0f3460" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding CurrentDate}" FontSize="12" Foreground="#9E9E9E"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="·" FontSize="12" Foreground="#0f3460" VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock Text="{Binding CurrentTime}" FontSize="12" Foreground="#00d2ff"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Bottom Dock -->
        <Border Grid.Row="3" Background="#16213e" Padding="16,12" BorderBrush="#0f3460"
                BorderThickness="0,1,0,0" CornerRadius="0,0,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Style="{StaticResource DockButtonStyle}"
                        Command="{Binding GoBackCommand}"
                        ToolTip="Back">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="White"/>
                </Button>

                <Button Style="{StaticResource DockButtonStyle}"
                        Command="{Binding GoHomeCommand}"
                        Margin="12,0"
                        ToolTip="Home">
                    <Ellipse Width="18" Height="18" Fill="Transparent" Stroke="White" StrokeThickness="2"/>
                </Button>

                <Button Style="{StaticResource DockButtonStyle}"
                        Command="{Binding OpenRecentsCommand}"
                        ToolTip="Recent Apps">
                    <Border Width="16" Height="16" BorderBrush="White" BorderThickness="2"
                            CornerRadius="3" Background="Transparent"/>
                </Button>

                <Border Width="1" Height="28" Background="#0f3460" Margin="16,0"/>

                <Button Style="{StaticResource DockButtonStyle}"
                        Command="{Binding RefreshAppsCommand}"
                        ToolTip="Refresh">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="White"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

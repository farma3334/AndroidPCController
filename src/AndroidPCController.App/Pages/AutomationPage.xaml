<UserControl x:Class="AndroidPCController.App.Pages.AutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AndroidPCController.App.ViewModels"
             xmlns:cvt="clr-namespace:AndroidPCController.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <cvt:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <cvt:StringToColorConverter x:Key="StringToColorConverter"/>

        <Style x:Key="NodeFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <Style x:Key="NodeTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#1A1A4E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#16213E" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Script:" FontSize="12" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ScriptName, UpdateSourceTrigger=PropertyChanged}"
                             Width="160" Style="{StaticResource NodeTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Loops:" FontSize="12" Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding LoopCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="44">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NodeTextBox}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoopForever}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <CheckBox Grid.Column="2" Content="Loop forever" Foreground="#E0E0E0" FontSize="12"
                          IsChecked="{Binding LoopForever}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <Button Grid.Column="3" Padding="14,6" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0"
                        Foreground="#1A1A2E" Command="{Binding RunScriptCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="b" Property="Background" Value="#335566"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D2FF" Offset="0"/>
                            <GradientStop Color="#4DFFB8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Play" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Run" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Padding="14,6" Cursor="Hand" FontWeight="SemiBold"
                        Background="#EF4444" Foreground="White" Margin="0,0,8,0"
                        Command="{Binding StopScriptCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Stop" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Padding="12,6" Cursor="Hand" Background="#0F3460" Foreground="#E0E0E0"
                            Margin="0,0,8,0" Command="{Binding SaveScriptCommand}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6" Cursor="Hand" Background="#0F3460" Foreground="#E0E0E0"
                            Margin="0,0,8,0" Command="{Binding LoadScriptCommand}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Load" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6" Cursor="Hand" Background="#0F3460" Foreground="#E0E0E0"
                            Command="{Binding ClearScriptCommand}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="DeleteSweep" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="6" Text="{Binding StatusText}" FontSize="11" Foreground="#00D2FF"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#16213E" CornerRadius="8" Margin="0,0,10,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Action Palette" FontSize="13" FontWeight="SemiBold"
                               Foreground="#E0E0E0" Margin="2,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PaletteActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="2,3" Padding="8,6" HorizontalAlignment="Stretch"
                                            Cursor="Hand" Background="#0F3460" Foreground="#E0E0E0"
                                            BorderThickness="0" Command="{Binding DataContext.AddNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#1E2D4A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+" FontWeight="Bold" Foreground="#00D2FF" Width="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#101426" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="WireCanvas" IsHitTestVisible="False" Background="Transparent"/>

                    <ItemsControl x:Name="NodeHost" ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FlowNodeViewModel}">
                                <Border Width="{x:Static vm:FlowNodeViewModel.NodeWidth}"
                                        Background="#16213E" CornerRadius="8"
                                        BorderBrush="#1E2D4A" BorderThickness="1"
                                        MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                        MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                        MouseMove="Node_MouseMove"
                                        MouseLeave="Node_MouseLeave"
                                        Cursor="SizeAll">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00D2FF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Border Height="36" Background="#1E2D4A" CornerRadius="8,8,0,0">
                                            <Grid Margin="8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="{Binding AccentColor, Converter={StaticResource StringToColorConverter}}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#E0E0E0"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                            Background="Transparent" BorderThickness="0" Foreground="#9E9E9E"
                                                            Cursor="Hand" ToolTip="Move up"
                                                            Command="{Binding DataContext.MoveNodeUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                            Background="Transparent" BorderThickness="0" Foreground="#9E9E9E"
                                                            Cursor="Hand" ToolTip="Move down"
                                                            Command="{Binding DataContext.MoveNodeDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                            Background="Transparent" BorderThickness="0" Foreground="#EF4444"
                                                            Cursor="Hand" ToolTip="Delete node"
                                                            Command="{Binding DataContext.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="10,4,10,10">
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#9E9E9E"
                                                       TextWrapping="Wrap" Margin="0,2,0,2"/>

                                            <Grid Visibility="{Binding HasXY, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="X" Style="{StaticResource NodeFieldLabel}"/>
                                                    <TextBox Text="{Binding XCoord, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Y" Style="{StaticResource NodeFieldLabel}"/>
                                                    <TextBox Text="{Binding YCoord, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Visibility="{Binding HasEnd, Converter={StaticResource BoolToVisConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="End X" Style="{StaticResource NodeFieldLabel}"/>
                                                    <TextBox Text="{Binding EndX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="End Y" Style="{StaticResource NodeFieldLabel}"/>
                                                    <TextBox Text="{Binding EndY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Visibility="{Binding HasDuration, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Duration (ms)" Style="{StaticResource NodeFieldLabel}"/>
                                                <TextBox Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding HasDelay, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Delay (ms)" Style="{StaticResource NodeFieldLabel}"/>
                                                <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding HasKey, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Key code (3=Home, 4=Back, 24=Vol+, 25=Vol-, 26=Power, 66=Enter, 82=Menu)"
                                                           Style="{StaticResource NodeFieldLabel}" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding KeyCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding HasText, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Text / Package name" Style="{StaticResource NodeFieldLabel}"/>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeTextBox}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Nodes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <md:PackIcon Kind="Flow" Width="40" Height="40" Foreground="#2A2A4A" HorizontalAlignment="Center"/>
                        <TextBlock Text="Add nodes from the palette to build your automation flow"
                                   FontSize="13" Foreground="#4A4A6A" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
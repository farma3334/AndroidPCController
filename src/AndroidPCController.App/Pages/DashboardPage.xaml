<UserControl x:Class="AndroidPCController.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AndroidPCController.App.Pages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#1a1a2e">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#1a1a4e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00d2ff"/>
                                <Setter Property="Foreground" Value="#1a1a2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#16213e" Padding="16,12" BorderBrush="#1a1a4e" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#e0e0e0"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="320" Margin="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                            Background="#0f3460" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="Cellphone" Width="28" Height="28"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                  Foreground="#00d2ff"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Model}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#e0e0e0"/>
                                        <TextBlock Foreground="#a0a0a0" FontSize="12">
                                            <Run Text="{Binding Manufacturer, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding AndroidVersion, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource BadgeStyle}"
                                            Background="{Binding ConnectionType, Converter={StaticResource ConnectionTypeToBrushConverter}}">
                                        <TextBlock Text="{Binding ConnectionType}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#ffffff"/>
                                    </Border>
                                </Grid>

                                <Separator Background="#1a1a4e" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Battery" FontSize="11" Foreground="#a0a0a0"/>
                                        <ProgressBar Value="{Binding BatteryLevel}" Maximum="100" Height="6"
                                                     Margin="0,4,0,0">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="{Binding BatteryLevel, Converter={StaticResource BatteryToColorConverter}}"/>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" FontSize="13"
                                               Foreground="#e0e0e0" Margin="8,0,0,2">
                                        <Run Text="{Binding BatteryLevel, Mode=OneWay}"/>
                                        <Run Text="%"/>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Latency" FontSize="10" Foreground="#a0a0a0"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Latency, StringFormat='{}{0}ms'}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#00d2ff"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Resolution" FontSize="10" Foreground="#a0a0a0"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#e0e0e0"
                                                   HorizontalAlignment="Center">
                                            <Run Text="{Binding ScreenWidth, Mode=OneWay}"/>
                                            <Run Text="x"/>
                                            <Run Text="{Binding ScreenHeight, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Status" FontSize="10" Foreground="#a0a0a0"
                                                   HorizontalAlignment="Center"/>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#ff5252"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                                            <Setter Property="Fill" Value="#00e676"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Unauthorized">
                                                            <Setter Property="Fill" Value="#ffc107"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionButton}" Content="Control"
                                            Command="{Binding DataContext.ControlDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Serial}"/>
                                    <Button Style="{StaticResource ActionButton}" Content="Files"
                                            Command="{Binding DataContext.OpenFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Serial}"/>
                                    <Button Style="{StaticResource ActionButton}" Content="Details"
                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Serial}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <materialDesign:PackIcon Kind="CellphoneOff" Width="80" Height="80"
                                         HorizontalAlignment="Center" Foreground="#1a1a4e"/>
                <TextBlock Text="No devices connected" FontSize="18" FontWeight="SemiBold"
                           Foreground="#a0a0a0" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                <TextBlock Text="Connect a device via USB or Wi-Fi to get started"
                           FontSize="13" Foreground="#a0a0a0" HorizontalAlignment="Center"
                           Opacity="0.7"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
